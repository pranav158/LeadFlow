# ─── Discord OAuth2 ────────────────────────────────────────────────────────────
# Create your app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# The redirect URI you registered in the Discord Developer Portal
# For local dev: http://localhost:3000/auth/discord/callback
# For production: https://yourdomain.com/auth/discord/callback
CALLBACK_URL=http://localhost:3000/auth/discord/callback

# ─── Access Control ────────────────────────────────────────────────────────────
# Comma-separated list of Discord user IDs allowed to access the app
# To find your Discord ID: Settings → Advanced → Developer Mode → right-click your name
ALLOWED_DISCORD_IDS=discord_user_id_1,discord_user_id_2

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Session ───────────────────────────────────────────────────────────────────
# A long random string (64+ hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_64_char_random_hex_string

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Backups ───────────────────────────────────────────────────────────────────
# Cron schedule for automatic backups (default: midnight daily)
BACKUP_CRON=0 0 * * *
# Number of backup files to keep (older ones are deleted automatically)
BACKUP_KEEP_COUNT=7
